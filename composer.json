{
	"name": "pixonaut/pixonaut-for-woocommerce",
	"description": "Connects a WooCommerce store to Pixonaut: personalised products, proofs and printshop orders.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=8.1",
		"nyholm/psr7": "^1.8",
		"pixonaut/pixonaut-php": "^5.0",
		"yahnis-elsts/plugin-update-checker": "^5.7"
	},
	"require-dev": {
		"brain/monkey": "^2.6",
		"brianhenryie/strauss": "^0.31",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0",
		"nikic/php-parser": "^5.0",
		"opis/json-schema": "^2.6",
		"php-stubs/woocommerce-stubs": "*",
		"php-stubs/wordpress-stubs": "*",
		"phpstan/extension-installer": "^1.4",
		"phpstan/phpstan": "^2.1",
		"phpunit/phpunit": "^9.6",
		"szepeviktor/phpstan-wordpress": "^2.0",
		"woocommerce/woocommerce-sniffs": "^1.0",
		"wp-cli/i18n-command": "^2.7",
		"wp-coding-standards/wpcs": "^3.1",
		"yoast/phpunit-polyfills": "^4.0"
	},
	"autoload": {
		"psr-4": {
			"Pixonaut\\WooCommerce\\": "src/"
		},
		"classmap": ["vendor/yahnis-elsts/plugin-update-checker/vendor/"]
	},
	"autoload-dev": {
		"psr-4": {
			"Pixonaut\\WooCommerce\\Tests\\": "tests/php/"
		}
	},
	"config": {
		"platform": {
			"php": "8.1.0"
		},
		"platform-check": false,
		"sort-packages": true,
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"phpstan/extension-installer": true
		}
	},
	"minimum-stability": "stable",
	"prefer-stable": true,
	"extra": {
		"strauss": {
			"target_directory": "vendor",
			"namespace_prefix": "Pixonaut\\WooCommerce\\Vendor\\",
			"classmap_prefix": "Pixonaut_WC_Vendor_",
			"constant_prefix": "PIXONAUT_WC_VENDOR_",
			"packages": [
				"nyholm/psr7",
				"pixonaut/pixonaut-php",
				"psr/http-client",
				"psr/http-factory",
				"psr/http-message",
				"psr/log",
				"yahnis-elsts/plugin-update-checker"
			],
			"override_autoload": {
				"yahnis-elsts/plugin-update-checker": {
					"classmap": ["Puc/", "vendor/"],
					"files": ["load-v5p7.php"]
				}
			},
			"include_modified_date": false,
			"include_author": false,
			"parallel": false
		}
	},
	"scripts": {
		"prefix-namespaces": [
			"@php bin/strauss.php",
			"@composer dump-autoload --optimize"
		],
		"post-install-cmd": ["@prefix-namespaces"],
		"post-update-cmd": ["@prefix-namespaces"]
	}
}
