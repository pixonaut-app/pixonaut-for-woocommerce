{
	"name": "pixonaut-for-woocommerce",
	"version": "1.6.2",
	"private": true,
	"description": "Connects a WooCommerce store to Pixonaut: personalised products, proofs and printshop orders.",
	"license": "GPL-2.0-or-later",
	"packageManager": "pnpm@12.18.0",
	"engines": {
		"node": ">=26"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "^26.13.0",
			"onFail": "download"
		}
	},
	"scripts": {
		"build": "wp-scripts build",
		"start": "wp-scripts start",
		"composer": "node bin/composer.mjs",
		"env:start": "node bin/wp-env.mjs start",
		"env:stop": "node bin/wp-env.mjs stop",
		"env:destroy": "node bin/wp-env.mjs destroy",
		"env:logs": "node bin/wp-env.mjs logs all",
		"env:cli": "node bin/wp-env.mjs run cli wp",
		"lint": "pnpm lint:js && pnpm lint:php && pnpm lint:workflows && pnpm typecheck",
		"lint:js": "biome check .",
		"lint:php": "node bin/php.mjs vendor/bin/phpcs",
		"lint:workflows": "node bin/actionlint.mjs",
		"format": "biome check --write .",
		"format:php": "node bin/composer.mjs exec phpcbf",
		"typecheck": "tsc --noEmit",
		"phpstan": "node bin/php.mjs vendor/bin/phpstan analyse --memory-limit=1G",
		"test:unit": "node bin/php.mjs vendor/bin/phpunit",
		"test:integration": "node bin/php.mjs --hpos=off vendor/bin/phpunit -c phpunit-integration.xml.dist && node bin/php.mjs --hpos=on vendor/bin/phpunit -c phpunit-integration.xml.dist && node bin/php.mjs --hpos=off env WP_MULTISITE=1 vendor/bin/phpunit -c phpunit-integration.xml.dist --group multisite",
		"test:js": "vitest run",
		"test:e2e": "playwright test --project=classic --project=block-primary --project=astra",
		"test:e2e:parallel": "node bin/e2e-sites.mjs test --project=classic --project=block-primary --project=astra",
		"test:e2e:secondary": "playwright test --project=block-secondary",
		"test:e2e:compat": "WP_ENV_COMPAT=1 playwright test --project='compat-*'",
		"i18n:pot": "node bin/i18n-pot.mjs",
		"i18n:update": "node bin/i18n-update.mjs",
		"i18n:build": "node bin/i18n-build.mjs",
		"i18n:check": "node bin/i18n-check.mjs",
		"docs:generate": "node bin/docs-generate.mjs",
		"contracts:pin": "node bin/contracts/pin.mjs",
		"contracts:consumed": "node bin/contracts/consumed-generate.mjs",
		"contract:check": "node bin/contracts/check.mjs",
		"check:conflicts": "node bin/check-conflict-markers.mjs",
		"check:headers": "node bin/check-headers.mjs",
		"check:docs-links": "node bin/docs/links.mjs",
		"plugin-check": "node bin/plugin-check.mjs",
		"release:zip": "node bin/release/zip.mjs",
		"release:check-zip": "node bin/release/check-zip.mjs",
		"release:check-templates": "node bin/release/check-template-versions.mjs",
		"ci:local": "node bin/ci-local.mjs",
		"ci:local:attest": "node bin/ci-local-attest.mjs post",
		"fake:types": "openapi-typescript contracts/pixonaut/openapi.json --output tests/fake-pixonaut/src/openapi.d.ts",
		"fake:build": "node tests/fake-pixonaut/scripts/build.mjs",
		"fake:start": "node bin/fake-pixonaut.mjs start",
		"fake:stop": "node bin/fake-pixonaut.mjs stop",
		"fake:logs": "node bin/fake-pixonaut.mjs logs"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@hono/node-server": "2.1.3",
		"@playwright/test": "1.64.1",
		"@types/node": "^24.0.0",
		"@wordpress/env": "11.17.0",
		"@wordpress/scripts": "36.1.0",
		"ajv": "8.20.0",
		"ajv-formats": "3.0.1",
		"esbuild": "0.28.2",
		"fflate": "0.8.2",
		"hono": "4.13.12",
		"jsdom": "30.1.1",
		"openapi-typescript": "7.13.0",
		"typescript": "^5.9.0",
		"vitest": "5.0.4"
	},
	"dependencies": {
		"@wordpress/hooks": "^4.57.0",
		"marked": "18.1.1"
	}
}
