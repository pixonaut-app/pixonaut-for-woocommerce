{
	"$schema": "https://schemas.wp.org/trunk/wp-env.json",
	"core": null,
	"phpVersion": "8.3",
	"plugins": [
		"https://downloads.wordpress.org/plugin/woocommerce.zip",
		"https://downloads.wordpress.org/plugin/plugin-check.2.1.0.zip",
		"https://downloads.wordpress.org/plugin/mcp-adapter.0.7.1.zip",
		"."
	],
	"themes": [
		"https://downloads.wordpress.org/theme/storefront.zip",
		"https://downloads.wordpress.org/theme/astra.zip"
	],
	"config": {
		"WP_DEBUG": true,
		"WP_DEBUG_LOG": true,
		"WP_DEBUG_DISPLAY": false,
		"SCRIPT_DEBUG": true
	},
	"env": {
		"tests": {
			"config": {
				"PIXONAUT_WC_E2E": true
			},
			"mappings": {
				"wp-content/mu-plugins": "./tests/e2e/mu-plugins",
				"wp-content/pixonaut-compat": "./tests/compat"
			}
		}
	}
}
