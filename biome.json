{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": [
			"**",
			"!contracts/pixonaut",
			"!languages",
			"!assets/build",
			"!tests/fake-pixonaut/src/openapi.d.ts",
			"!tests/fake-pixonaut/fixtures",
			"!tests/fake-pixonaut/dist"
		]
	},
	"formatter": {
		"indentStyle": "tab",
		"lineWidth": 80
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "single"
		}
	},
	"linter": {
		"enabled": true
	}
}
