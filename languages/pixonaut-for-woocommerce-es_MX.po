#: src/Emails/ChangesRequestedEmail.php:42
msgid ""
"Sent to the store when a customer asked for changes to the proof of their "
"design, with what they asked."
msgstr ""
"Se envía a la tienda cuando un cliente pide cambios en la prueba de su "
"diseño, con lo que pidió."

#. translators: Default subject of the email to the merchant. {order_number}, {site_title} and similar in braces are filled in by WooCommerce; keep them as written.
#: src/Emails/ChangesRequestedEmail.php:56
msgid "[{site_title}]: Changes requested for order #{order_number}"
msgstr "[{site_title}]: Cambios solicitados para el pedido #{order_number}"

#. translators: Default heading at the top of the email to the merchant. Text in braces is filled in by WooCommerce; keep it as written.
