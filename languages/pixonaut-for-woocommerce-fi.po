msgstr ""
"Pixonaut: tuotteen ”%s” uusi osoite lähtee painotaloon tilauksen mukana, "
"koska tilausta ei ollut vielä lähetetty."

#. translators: %s: product name of the order line.
#: src/Fulfilment/DeliveryChange.php:735
#, php-format
msgid ""
"Pixonaut: the printshop refused the new address of \"%s\". It ships to the "
"address it had."
msgstr ""
"Pixonaut: painotalo hylkäsi tuotteen ”%s” uuden osoitteen. Tuote toimitetaan "
"aiempaan osoitteeseen."

#. translators: %s: product name of the order line.
#: src/Fulfilment/DeliveryChange.php:737
#, php-format
msgid "Pixonaut is telling the printshop the new address of \"%s\"."
msgstr "Pixonaut ilmoittaa painotalolle tuotteen ”%s” uuden osoitteen."

