#: templates/admin/connection-card.php:190
msgid "Orders placed in the sandbox never reach a printshop."
msgstr "Beställningar som läggs i sandboxen når aldrig ett tryckeri."

#. translators: Row heading on the connection card: the store's address.
#: templates/admin/connection-card.php:195
msgid "Site URL"
msgstr "Webbplatsens URL"

#. translators: Row heading on the connection card: the www. address of the site, which can be allowed in addition.
#: templates/admin/connection-card.php:200
