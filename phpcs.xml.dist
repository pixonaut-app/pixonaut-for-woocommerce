<?xml version="1.0"?>
<ruleset name="pixonaut-for-woocommerce">
    <description>WordPress Coding Standards 3 with the WooCommerce sniffs.</description>

    <file>pixonaut-for-woocommerce.php</file>
    <file>uninstall.php</file>
    <file>src</file>
    <file>templates</file>
    <file>tests/php</file>
    <file>tests/e2e/mu-plugins</file>
    <file>tests/compat</file>

    <arg name="basepath" value="."/>
    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="sp"/>
    <!-- The container cannot write a cache into the mounted checkout. -->
    <arg name="cache" value="/tmp/phpcs-pixonaut-wc.cache"/>
    <!-- Writing the cache of a full run needs more than the container's default 128M. -->
    <ini name="memory_limit" value="512M"/>

    <config name="testVersion" value="8.1-"/>
    <config name="minimum_wp_version" value="6.9"/>

    <rule ref="WordPress">
        <!-- PSR-4 class files. -->
        <exclude name="WordPress.Files.FileName"/>
        <!-- Types and names carry what these comments would repeat. -->
        <exclude name="Squiz.Commenting.FunctionComment.Missing"/>
        <exclude name="Squiz.Commenting.FunctionComment.MissingParamComment"/>
        <exclude name="Squiz.Commenting.ClassComment.Missing"/>
        <exclude name="Squiz.Commenting.VariableComment.Missing"/>
        <exclude name="Generic.Commenting.DocComment.MissingShort"/>
        <!-- Exception messages are not output; whoever prints one escapes it. -->
        <exclude name="WordPress.Security.EscapeOutput.ExceptionNotEscaped"/>
    </rule>
    <rule ref="WooCommerce-Core">
        <exclude name="Core.Commenting.CommentTags.AuthorTag"/>
    </rule>

    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="pixonaut-for-woocommerce"/>
            </property>
        </properties>
    </rule>
    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
        <properties>
            <property name="prefixes" type="array">
                <element value="pixonaut"/>
                <element value="Pixonaut\WooCommerce"/>
            </property>
        </properties>
    </rule>

    <!-- The bundled Pixonaut SDK's models, exceptions and requests name their properties in camelCase, as the API does. -->
    <rule ref="WordPress.NamingConventions.ValidVariableName.UsedPropertyNotSnakeCase">
        <severity>0</severity>
    </rule>

    <!-- Tests fire WordPress's own hooks and define its constants. -->
    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
        <exclude-pattern>tests/php/*</exclude-pattern>
    </rule>
    <rule ref="WooCommerce.Commenting.CommentHooks">
        <exclude-pattern>tests/php/*</exclude-pattern>
    </rule>

    <!-- Test method names follow PHPUnit's test_ prefix, and tests need no file docblocks. -->
    <rule ref="Squiz.Commenting.FileComment">
        <exclude-pattern>tests/php/*</exclude-pattern>
    </rule>
</ruleset>
