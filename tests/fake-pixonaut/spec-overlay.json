{
	"entries": [
		{
			"pointer": "/paths/~1v1~1connect~1picture-storage",
			"awaits": "pixonaut-app/pixonaut#3918",
			"value": {
				"put": {
					"operationId": "connectedStore.reportPictureStorage",
					"summary": "Report the pictures a store keeps",
					"tags": ["API keys"],
					"description": "Called with the store's own integration key to say how much room the pictures it keeps for Pixonaut products take, in total and per product, and where a member changes it in the store's admin. Each report replaces the last. Pixonaut shows it in the studio and answers 204.",
					"security": [
						{
							"integrationKey": []
						}
					],
					"requestBody": {
						"required": true,
						"content": {
							"application/json": {
								"schema": {
									"type": "object",
									"additionalProperties": false,
									"required": [
										"pictureCount",
										"pictureBytes",
										"variationPictureCount",
										"variationPictureBytes",
										"freeBytes",
										"variationPicturesOn",
										"links",
										"products"
									],
									"properties": {
										"pictureCount": {
											"type": "integer",
											"minimum": 0,
											"description": "How many pictures the store keeps in its media library for Pixonaut products."
										},
										"pictureBytes": {
											"type": "integer",
											"minimum": 0,
											"description": "The bytes those pictures take."
										},
										"variationPictureCount": {
											"type": "integer",
											"minimum": 0,
											"description": "How many of the pictures are variation pictures."
										},
										"variationPictureBytes": {
											"type": "integer",
											"minimum": 0,
											"description": "The bytes the variation pictures take."
										},
										"freeBytes": {
											"anyOf": [
												{
													"type": "integer",
													"minimum": 0
												},
												{
													"type": "null"
												}
											],
											"description": "The bytes free on the store's disk; null when the store cannot tell."
										},
										"variationPicturesOn": {
											"type": "boolean",
											"description": "Whether the store draws a picture per variation."
										},
										"links": {
											"type": "object",
											"additionalProperties": false,
											"required": ["variationSetting", "cleanUp"],
											"properties": {
												"variationSetting": {
													"anyOf": [
														{
															"type": "string"
														},
														{
															"type": "null"
														}
													],
													"description": "Where a member turns variation pictures on or off in the store's admin; null when there is no such page."
												},
												"cleanUp": {
													"anyOf": [
														{
															"type": "string"
														},
														{
															"type": "null"
														}
													],
													"description": "Where a member cleans up the store's pictures in its admin; null when there is no such page."
												}
											}
										},
										"productCount": {
											"type": "integer",
											"minimum": 0,
											"description": "How many products hold at least one Pixonaut picture, those past the cap included; left out, the products listed."
										},
										"products": {
											"type": "array",
											"maxItems": 1000,
											"description": "The products that keep pictures, each with what it uses.",
											"items": {
												"type": "object",
												"additionalProperties": false,
												"required": [
													"storeProductId",
													"name",
													"pictureCount",
													"pictureBytes",
													"variationPictureCount",
													"variationPictureBytes",
													"variationPicturesOn",
													"editUrl"
												],
												"properties": {
													"storeProductId": {
														"type": "string",
														"minLength": 1,
														"description": "The product's id in the store."
													},
													"name": {
														"type": "string",
														"maxLength": 200,
														"description": "The product's name."
													},
													"pictureCount": {
														"type": "integer",
														"minimum": 0,
														"description": "How many pictures the product keeps."
													},
													"pictureBytes": {
														"type": "integer",
														"minimum": 0,
														"description": "The bytes they take."
													},
													"variationPictureCount": {
														"type": "integer",
														"minimum": 0,
														"description": "How many of them are variation pictures."
													},
													"variationPictureBytes": {
														"type": "integer",
														"minimum": 0,
														"description": "The bytes the variation pictures take."
													},
													"variationPicturesOn": {
														"type": "boolean",
														"description": "Whether the product draws a picture per variation."
													},
													"editUrl": {
														"anyOf": [
															{
																"type": "string"
															},
															{
																"type": "null"
															}
														],
														"description": "Where a member edits the product in the store's admin; null when there is none."
													}
												}
											}
										}
									}
								}
							}
						}
					},
					"responses": {
						"204": {
							"description": "The report is held",
							"headers": {
								"X-Request-Id": {
									"$ref": "#/components/headers/RequestId"
								}
							}
						},
						"400": {
							"content": {
								"application/json": {
									"examples": {
										"invalid_input": {
											"summary": "invalid_input",
											"value": {
												"error": "invalid_input"
											}
										}
									},
									"schema": {
										"properties": {
											"error": {
												"type": "string",
												"x-extensible-enum": ["invalid_input"]
											}
										},
										"required": ["error"],
										"type": "object"
									}
								}
							},
							"description": "Refused: invalid_input",
							"headers": {
								"X-Request-Id": {
									"$ref": "#/components/headers/RequestId"
								}
							}
						},
						"401": {
							"content": {
								"application/json": {
									"examples": {
										"unauthorized": {
											"summary": "unauthorized",
											"value": {
												"error": "unauthorized"
											}
										}
									},
									"schema": {
										"properties": {
											"error": {
												"type": "string",
												"x-extensible-enum": ["unauthorized"]
											}
										},
										"required": ["error"],
										"type": "object"
									}
								}
							},
							"description": "Refused: unauthorized",
							"headers": {
								"X-Request-Id": {
									"$ref": "#/components/headers/RequestId"
								}
							}
						},
						"403": {
							"content": {
								"application/json": {
									"examples": {
										"feature_disabled": {
											"summary": "feature_disabled",
											"value": {
												"error": "feature_disabled",
												"feature": "api"
											}
										},
										"forbidden": {
											"summary": "forbidden",
											"value": {
												"error": "forbidden"
											}
										},
										"origin_forbidden": {
											"summary": "origin_forbidden",
											"value": {
												"error": "origin_forbidden"
											}
										}
									},
									"schema": {
										"properties": {
											"error": {
												"type": "string",
												"x-extensible-enum": [
													"origin_forbidden",
													"forbidden",
													"feature_disabled"
												]
											},
											"feature": {
												"description": "The feature the tenant does not have. Always sent with `feature_disabled`.",
												"type": "string",
												"x-extensible-enum": [
													"api",
													"automations",
													"embroidery",
													"mcp"
												]
											}
										},
										"required": ["error"],
										"type": "object"
									}
								}
							},
							"description": "Refused: origin_forbidden, forbidden, feature_disabled",
							"headers": {
								"X-Request-Id": {
									"$ref": "#/components/headers/RequestId"
								}
							}
						},
						"404": {
							"content": {
								"application/json": {
									"examples": {
										"not_found": {
											"summary": "not_found",
											"value": {
												"error": "not_found"
											}
										}
									},
									"schema": {
										"properties": {
											"error": {
												"type": "string",
												"x-extensible-enum": ["not_found"]
											}
										},
										"required": ["error"],
										"type": "object"
									}
								}
							},
							"description": "Refused: not_found",
							"headers": {
								"X-Request-Id": {
									"$ref": "#/components/headers/RequestId"
								}
							}
						},
						"429": {
							"content": {
								"application/json": {
									"examples": {
										"rate_limited": {
											"summary": "rate_limited",
											"value": {
												"error": "rate_limited"
											}
										}
									},
									"schema": {
										"properties": {
											"error": {
												"type": "string",
												"x-extensible-enum": ["rate_limited"]
											}
										},
										"required": ["error"],
										"type": "object"
									}
								}
							},
							"description": "Refused: rate_limited",
							"headers": {
								"X-Request-Id": {
									"$ref": "#/components/headers/RequestId"
								}
							}
						}
					}
				}
			}
		}
	]
